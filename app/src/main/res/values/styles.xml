<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.Domotica.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Domotica.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Domotica.Card</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <style name="ShapeAppearance.Domotica.Card" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_md</item>
    </style>

    <style name="Widget.Domotica.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintAnimationEnabled">true</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>

    <style name="TextAppearance.Domotica.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

</resources>
